
HTTP_ADDR=:8080
REDIS_ADDR=redis:6379
EVENT_QUEUE=notifiq:events
EMAIL_JOB_QUEUE=notifiq:email_jobs
EMAIL_DEAD_LETTER_QUEUE=notifiq:email_jobs:dead_letters

MYSQL_ADDR=mysql:3306
MYSQL_DATABASE=notifiq
MYSQL_USER=notifiq
MYSQL_PASSWORD=change-this-password

# Use long random values in every non-development environment.
JWT_SECRET=replace-with-at-least-32-random-characters
EMAIL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
WEBHOOK_SECRET=replace-with-a-random-webhook-secret

PASSWORD_RESET_URL=http://localhost:3000/reset-password
INVITE_URL=http://localhost:3000/invite
MIGRATION_PATH=db/migrations

# Optional Docker secrets or external secret-manager file mounts.
# *_FILE takes precedence over the matching plain-text variable.
# MYSQL_PASSWORD_FILE=/run/secrets/mysql_password
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# EMAIL_ENCRYPTION_KEY_FILE=/run/secrets/email_encryption_key
# WEBHOOK_SECRET_FILE=/run/secrets/webhook_secret
